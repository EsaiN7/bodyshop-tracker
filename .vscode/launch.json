{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask Debug",
            "type": "python",
            "request": "launch",
            "module": "flask",              // <-- MUST be module, not program
            "env": {
                "FLASK_APP": "run.py",
                "FLASK_ENV": "development"
            },
            "args": [
                "run",
                "--no-reload"
            ],
            "jinja": true,
            "justMyCode": true
        }
    ]
}
